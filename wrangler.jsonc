// Cloudflare deploy settings. Deploy with:  npx wrangler@4 deploy
// Secrets (set once, never in this file):
//   npx wrangler@4 secret put ELEVENLABS_SERVER_KEY
//   npx wrangler@4 secret put ELEVENLABS_AGENT_ID
//   npx wrangler@4 secret put TESTER_KEY      (the owner's test code; voice is off for everyone else)
{
  "name": "kungfu-fitness",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",

  // app/ is published as static files; what's listed in app/.assetsignore is left out
  "assets": {
    "directory": "./app",
    "binding": "ASSETS"
  },

  // /api/token: at most 5 tickets per minute per visitor (period must be 10 or 60 s)
  "ratelimits": [
    { "name": "TOKEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  // errors from worker.js show up in the Cloudflare dashboard
  "observability": { "enabled": true }
}
